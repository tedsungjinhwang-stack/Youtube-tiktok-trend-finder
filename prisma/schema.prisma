generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  XIAOHONGSHU
  DOUYIN
}

model Folder {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isSeeded  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  channels  Channel[]
  stock     StockMaterial[]
}

/// 소재 창고 — 폴더별로 영구 보관되는 URL/제목/설명. 자동 정리 X.
model StockMaterial {
  id          String   @id @default(cuid())
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([folderId, createdAt])
}

model Channel {
  id              String    @id @default(cuid())
  platform        Platform
  externalId      String
  handle          String?
  displayName     String?
  thumbnailUrl    String?
  subscriberCount Int?
  totalViewCount  BigInt?
  folderId        String
  folder          Folder    @relation(fields: [folderId], references: [id])
  isActive        Boolean   @default(true)
  /// 'REFERENCE' (레퍼런스) | 'SOURCE' (원본 소스)
  kind            String    @default("REFERENCE")
  addedAt         DateTime  @default(now())
  lastScrapedAt   DateTime?
  /// 옛날 영상 깊이 스크랩 완료 시점. null = 아직 미실행. 채널 추가 시 백필 cron 이 처리.
  backfilledAt    DateTime?

  @@unique([platform, externalId])
  @@index([folderId])
  @@index([kind])
}

/// 유튜브 Data API 키 (여러 개 등록 시 가장 덜 쓴 키부터 순환). 할당량은 PT 자정에 초기화.
model YoutubeApiKey {
  id              String    @id @default(cuid())
  label           String
  apiKey          String    @unique
  isActive        Boolean   @default(true)
  dailyQuotaLimit Int       @default(10000)
  usedToday       Int       @default(0)
  lastUsedAt      DateTime?
  exhaustedAt     DateTime?
  resetAt         DateTime?
  failCount       Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
}

model Credential {
  id          String   @id @default(cuid())
  service     String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// 내 채널 스케줄 관리 — 채널 메타.
model MyChannel {
  id           String                @id @default(cuid())
  name         String
  /// 대분류 플랫폼: 'YOUTUBE' | 'TIKTOK' | 'INSTAGRAM' | 'FACEBOOK' | 'THREADS' | 'NAVER_CLIP'
  platform     String                @default("YOUTUBE")
  /// 소속 대시보드/Todoist 그룹: 'youtube' | 'shopping' | 'threads'.
  /// 플랫폼으로 자동 결정되지만 TikTok 은 양쪽 대시보드에 보이므로 이 값으로 Todoist 귀속을 정함.
  todoistGroup String                @default("youtube")
  category     String?
  url          String?
  adsense      String?
  email        String?
  phone        String?
  /// 스레드 계정 전용 메모 — 멀티로그인 프로필 번호 등 자유 텍스트.
  profile      String?
  /// 같이 올리는 틱톡 계정 (핸들 또는 주소). 틱톡은 유튜브와 같은 영상을 함께 올리므로
  /// 별도 채널로 만들지 않고 짝으로 붙여 둔다 — 일정이 두 벌이 되지 않게.
  tiktokUrl    String?
  /// 수익창출 상태: 'PRE_MONETIZATION'(수창 전) | 'MONETIZED'(수창 완료) | 'UNKNOWN'(미확인).
  /// 카테고리와 별개 속성. 확인 안 된 채널을 수창 완료로 단정하지 않도록 기본은 UNKNOWN.
  /// 수창 전은 목록 아래 별도 그룹으로 보이고, 승인되면 이 값만 바꾸면 그룹이 옮겨진다.
  /// (DB 에 CHECK 제약 MyChannel_monetizationStatus_check 가 걸려 있다)
  monetizationStatus String          @default("UNKNOWN")
  sortOrder    Int                   @default(0)
  /// 비활성화하면 cron/캘린더 동기화에서 제외. 기존 GCal 이벤트는 건드리지 않음.
  isActive     Boolean               @default(true)
  /// 채널 단위 1개 GCal 이벤트 (마지막 예약일자, 제목="채널명 (N)")
  gcalEventId  String?
  gcalSyncedAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  videos       ScheduledVideo[]
  youtubeOauth ChannelYouTubeOAuth?
  materials    ChannelMaterial[]
  attachments  ChannelAttachment[]

  @@index([adsense])
  @@index([platform])
}

/// 채널별 소재 (영상 URL) 풀. 체크 = 사용 완료 → 삭제해서 목록에서 사라지게 함.
model ChannelMaterial {
  id        String    @id @default(cuid())
  channelId String
  channel   MyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  url       String
  note      String?
  createdAt DateTime  @default(now())

  @@index([channelId])
  @@index([createdAt])
}

/// 채널별 완성본 첨부 (URL 또는 외부 파일 호스팅 링크). 채널당 최대 5개.
model ChannelAttachment {
  id        String    @id @default(cuid())
  channelId String
  channel   MyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  createdAt DateTime  @default(now())

  @@index([channelId])
  @@index([createdAt])
}

/// 내 채널의 예약 영상.
model ScheduledVideo {
  id             String    @id @default(cuid())
  channelId      String
  channel        MyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  scheduledAt    DateTime
  status         String    @default("planned")
  /// 발행 완료 후 실제 게시물 링크 (스레드/인스타 등 수동 입력)
  publishedUrl   String?
  youtubeVideoId String?
  gcalEventId    String?
  gcalSyncedAt   DateTime?
  todoistTaskId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([channelId, youtubeVideoId])
  @@index([channelId])
  @@index([scheduledAt])
}

/// Todoist 연동 설정. 싱글톤 (id='default'). 개인 API 토큰은 만료 없음.
model TodoistConfig {
  id          String   @id @default("default")
  apiToken    String
  /// 유튜브 대시보드용 프로젝트 (레거시 컬럼명 유지)
  projectId   String?
  projectName String   @default("유튜브")
  /// 인스타 대시보드용 (칼럼 이름의 shopping 은 예전 '쇼핑쇼츠' 시절 이름)
  shoppingProjectId   String?
  shoppingProjectName String  @default("인스타")
  /// 네이버클립 대시보드용
  naverclipProjectId   String?
  naverclipProjectName String @default("네이버클립")
  /// 스레드 대시보드용
  threadsProjectId    String?
  threadsProjectName  String  @default("스레드")
  /// 전체 현황의 직접 쓰는 할 일. 채널 자동 태스크와 섞이면 정리 로직에 지워질 수 있어 프로젝트를 분리한다.
  todoProjectId       String?
  todoProjectName     String  @default("새로이 할일")
  accountName String?
  lastSyncedAt DateTime?
  lastSyncError String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Google OAuth (Calendar 동기화용). 싱글톤 (id='default').
model GoogleOAuth {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  accountEmail String?
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 채널별 YouTube OAuth 토큰 (예약 영상 자동 가져오기).
model ChannelYouTubeOAuth {
  id                 String    @id @default(cuid())
  myChannelId        String    @unique
  myChannel          MyChannel @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  youtubeChannelId   String?
  youtubeChannelName String?
  accountEmail       String?
  lastSyncedAt       DateTime?
  lastSyncError      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// 전체 현황의 주간/월간/연간 계획 메모. Todoist 와 무관하게 앱 안에서만 보는 자유 텍스트.
/// id 는 'weekly' | 'monthly' | 'yearly' 세 행만 쓴다.
model PlanNote {
  id        String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

/// 트렌드 탭 원본 응답 캐시. 외부 소스(구글·네이버)를 화면 열 때마다 부르면
/// 막히기 쉬워서, 소스+조건을 key 로 잠깐 저장해 두고 재사용한다.
model TrendCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

/// 네이버 검색광고 키워드도구의 월간 검색수 (최근 30일 합계). 키워드는 공백 제거·소문자로 저장.
/// "< 10" 은 5 로, 네이버에 데이터가 없는 키워드는 pc/mobile 을 null 로 둔다 (다시 묻지 않으려고).
model KeywordVolume {
  keyword   String   @id
  pc        Int?
  mobile    Int?
  /// '높음' | '중간' | '낮음'
  comp      String?
  /// 월평균 클릭수·클릭률(%)·노출 광고 수
  pcClk     Float?
  mobileClk Float?
  pcCtr     Float?
  mobileCtr Float?
  adDepth   Int?
  fetchedAt DateTime @default(now())
}
